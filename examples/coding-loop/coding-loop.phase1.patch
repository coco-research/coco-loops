+def _git_untracked_new(before_dirty: set[str]) -> list[str]:
+    """Repo-relative paths of untracked files that appeared after before_dirty."""
+    raw = run_bash("git status --porcelain")
+    new_untracked: list[str] = []
+    for line in raw.splitlines():
+        if line.startswith("exit="):
